# ---- Public (VITE_*): shipped to the browser. Never put secrets here. ----

# Optional. Set to a backend URL to use the HTTP adapter instead of in-browser storage.
VITE_API_URL=

# "true" when this deployment runs the built-in Gemini proxy (api/ai/gemini.ts).
# Users then get AI without entering a key; they can still add their own in Settings.
VITE_BUILTIN_AI=true

# ---- Server-only: read by the Vercel Function / Vite dev server, never bundled. ----

# Your Google AI Studio key (starts with "AQ." or "AIza"). Put the real value in
# .env.local (git-ignored) for local dev, and in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=
